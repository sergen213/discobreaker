{
  "productName": "Disco Breaker",
  "version": "1.0.1",
  "identifier": "com.discobreaker.player",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "appimage",
      "app"
    ],
    "resources": {
      "../../site/": "site/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Music",
    "shortDescription": "Disco Breaker, Turkey's first HTML5 music video (2011), restored",
    "copyright": "Disco Breaker (c) Microsoft 2011, Bedük",
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      }
    }
  }
}
